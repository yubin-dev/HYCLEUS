# Auto detect text files and perform LF normalization
* text=auto

# Kabuk betikleri ve AppRun HER ZAMAN LF.
#
# `text=auto` deponun İÇİNDE LF tutuyor ama Windows'ta çalışma ağacına
# CRLF olarak açıyor (core.autocrlf). Bu depo Windows'ta geliştiriliyor ve
# Linux'ta paketleniyor; CRLF taşıyan bir betiğin ilk satırı
# `#!/usr/bin/env bash\r` olur ve çekirdek `bash\r` diye bir yorumlayıcı
# arayıp "bad interpreter" ile düşer. Hata mesajı görünmez bir karakteri
# işaret ettiği için tanınması zor.
*.sh        text eol=lf
AppRun      text eol=lf
*.desktop   text eol=lf

# Kullanıcı rehberi: BAYTLARI İMZALANIYOR, o yüzden HER ZAMAN LF.
#
# `docs/kullanici-rehberi.pdf`, üretildiği Markdown'ın SHA-256'sını kendi
# `/Subject` alanında taşıyor (CORE/rehber.py). Bu dosya Windows çalışma
# ağacında CRLF'e açıldığı için Windows'ta üretilen özet, Linux'ta
# hesaplanan özetle TUTMUYORDU — CI 71 ve 72'de dört test bu yüzden düştü:
#
#     Windows çalışma ağacı : 14210 bayt, 368 CRLF, 13be125c...
#     git blob (= Linux)    : 13842 bayt,   0 CRLF, 552117f7...
#
# İki katmanlı önlem: özet artık satır sonlarını normalleştiriyor
# (`CORE/rehber.py::kanonik`) VE dosya iki platformda da aynı biçimde
# duruyor. Biri tek başına yeterli olurdu ama ikisi ayrı şeyi koruyor:
# buradaki satır çalışma ağacını, oradaki normalleştirme dosyayı bu depo
# dışında düzenleyen araçları.
docs/kullanici-rehberi.md   text eol=lf

# Üretilmiş ikili çıktı — satır sonu normalleştirmesi UYGULANMAMALI.
# `text=auto` bugün onu ikili sayıyor (sezgisel), ama sezgi bir sözleşme
# değil: yanılırsa PDF sessizce bozulur ve bozulma yalnızca Windows'ta
# görünür.
*.pdf       binary
